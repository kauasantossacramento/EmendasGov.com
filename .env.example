# ============================================================================
# EmendasGov.com — Exemplo de configuração de ambiente
#
# Como usar:
#   1. Copie este arquivo:            cp .env.example .env
#   2. Preencha as chaves abaixo no .env
#   3. Reinicie o servidor (as variáveis são lidas na inicialização)
#
# O .env está no .gitignore e NUNCA deve ser commitado — só este exemplo.
# Variáveis já definidas no sistema têm prioridade sobre o .env.
# ============================================================================


# ----------------------------------------------------------------------------
# CGU — Portal da Transparência (OBRIGATÓRIA para a sincronização de emendas)
#
# Onde obter (gratuito):
#   1. Acesse https://api.portaldatransparencia.gov.br/
#   2. Clique em "Cadastre seu e-mail" e confirme o cadastro
#   3. A chave (chave-api-dados) chega no seu e-mail
# ----------------------------------------------------------------------------
PORTAL_TRANSPARENCIA_API_KEY=cole-aqui-a-chave-recebida-por-email


# ----------------------------------------------------------------------------
# Google Gemini — Assistente de Transparência IA (chat do portal)
#
# Onde obter: https://aistudio.google.com/apikey  →  "Create API key"
# Sem esta chave o chat responde com mensagem orientativa (portal funciona).
# ----------------------------------------------------------------------------
GEMINI_API_KEY=cole-aqui-a-chave-do-google-ai-studio
# Modelo utilizado (opcional; padrão: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash


# ----------------------------------------------------------------------------
# Google reCAPTCHA v2 ("Não sou um robô") — gateway da área pública
#
# Onde obter (gratuito): https://www.google.com/recaptcha/admin/create
#   - Tipo: reCAPTCHA v2 → caixa "Não sou um robô"
#   - Domínios: localhost, seu domínio e (para testes) app.github.dev
# Sem estas chaves o gateway fica desativado (útil em desenvolvimento).
# ----------------------------------------------------------------------------
RECAPTCHA_SITE_KEY=cole-aqui-a-chave-do-site
RECAPTCHA_SECRET_KEY=cole-aqui-a-chave-secreta


# ----------------------------------------------------------------------------
# Django — ajustes de produção
# ----------------------------------------------------------------------------
# Gere uma chave forte, ex.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Em produção use 0 (desliga páginas de erro detalhadas)
DJANGO_DEBUG=1
# Domínios aceitos, separados por vírgula
DJANGO_ALLOWED_HOSTS=*
# Origens confiáveis para CSRF (produção: https://seudominio.com.br)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.app.github.dev


# ----------------------------------------------------------------------------
# Banco de dados PostgreSQL (opcional — sem isso usa SQLite local)
# ----------------------------------------------------------------------------
# POSTGRES_DB=emendasgov
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=senha-do-banco
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432


# ----------------------------------------------------------------------------
# Endpoints das APIs federais (opcional — só altere se os endereços mudarem)
# ----------------------------------------------------------------------------
# TRANSFEREGOV_API_BASE=https://api.transferegov.gestao.gov.br
# PORTAL_TRANSPARENCIA_API_BASE=https://api.portaldatransparencia.gov.br
# PNCP_API_BASE=https://pncp.gov.br/api/consulta
