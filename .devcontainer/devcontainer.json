{
  "name": "EmendasGov.com",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt && python manage.py migrate && python manage.py popular_demo",
  "postAttachCommand": {
    "servidor": "python manage.py runserver 0.0.0.0:8000"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Portal EmendasGov.com",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
